# Link local workspace packages to satisfy plain semver ranges (not just workspace: specs), so the
# template's `@react-three/nativescript: ^10.0.0-alpha.2` resolves to the local package in-repo.
link-workspace-packages=true

# NativeScript needs two things from node_modules that fight each other under pnpm:
#  1. Undeclared/implicit requires (e.g. @nativescript/webpack -> acorn-stage3) must resolve. With the
#     default linker, shamefully-hoist=true lifts every transitive package into the root node_modules,
#     which is an ancestor of the .pnpm store, so those bare requires resolve.
#  2. Each app's own node_modules must contain its direct deps, because iOS plugin Podfiles use
#     RELATIVE paths (e.g. `../../node_modules/@nativescript/canvas/...`). The default symlinked linker
#     gives examples/flatland/node_modules/@nativescript/canvas, so those paths resolve. (node-linker=
#     hoisted empties the per-app node_modules and breaks the iOS Podfile paths.)
# So: default linker + shamefully-hoist, NOT node-linker=hoisted.
shamefully-hoist=true

# The NativeScript CLI also auto-runs `pnpm i --shamefully-hoist` when its dependency-presence check
# misfires; matching the flag here keeps that install a no-op instead of a TTY-less rebuild.
