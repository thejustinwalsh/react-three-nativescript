    {
      "type": "text",
      "id": "ios-cap",
      "x": 565.4010620117188,
      "y": 855.39453125,
      "width": 800,
      "height": 54,
      "text": "why asymmetric: WKWebView strips the body of custom-scheme requests, so the decoded result can't ride\nnsbin:// back — it returns base64-tagged + chunked over the script-message bridge. Inputs can go binary.",
      "originalText": "why asymmetric: WKWebView strips the body of custom-scheme requests, so the decoded result can't ride\nnsbin:// back — it returns base64-tagged + chunked over the script-message bridge. Inputs can go binary.",
