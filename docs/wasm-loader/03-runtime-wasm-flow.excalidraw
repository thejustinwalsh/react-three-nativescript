    {
      "type": "text",
      "id": "ios-cap",
      "x": 566,
      "y": 856,
      "width": 800,
      "height": 54,
      "text": "why asymmetric: WKWebView strips the body of custom-scheme requests, so the decoded result can't ride\nnsbin:// back \u2014 it returns base64-tagged + chunked over the script-message bridge. Inputs can go binary.",
      "originalText": "why asymmetric: WKWebView strips the body of custom-scheme requests, so the decoded result can't ride\nnsbin:// back \u2014 it returns base64-tagged + chunked over the script-message bridge. Inputs can go binary.",
